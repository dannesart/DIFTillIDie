# Copy to .env (never committed) and fill in.
# Public values: the publishable key is designed to be shipped to browsers.
# Never put the secret / service_role key in this app.
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Server-only (never NUXT_PUBLIC_*): signs Story captures so posts keep their
# Story after it leaves the feeds. The same secret goes in Supabase Vault as
# "story_capture_key:<id>" (see docs/snacket-posts.md). Without it, Stories
# can't be attached. Generate with: openssl rand -hex 32
NUXT_STORY_CAPTURE_KEY_ID=
NUXT_STORY_CAPTURE_KEY=
